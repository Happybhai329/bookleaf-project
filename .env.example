NODE_ENV=development

# Google Gemini
GEMINI_API_KEY=replace_with_a_new_rotated_key
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# Supabase PostgreSQL
DATABASE_URL=replace_with_supabase_runtime_connection_string
DIRECT_URL=replace_with_supabase_migration_connection_string

# Database adapter selection (postgres or json)
DATA_PROVIDER=postgres

# Authentication & Session
SESSION_SECRET=replace_with_a_strong_random_secret
COOKIE_SECURE=false

# Development-only seeding
SEED_DEMO_USERS=true
DEMO_AUTHOR_PASSWORD=replace_with_a_strong_local_password
ADMIN_EMAIL=admin@bookleaf.in
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Frontend URL
FRONTEND_URL=http://localhost:5173
